{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "reference/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Playfair Display|Montserrat|Great Vibes))/i]",
        "message": "Font not provided by the design system. Available: Playfair Display, Montserrat, Great Vibes."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--background",
      "--bg",
      "--bg-elev",
      "--bg-warm",
      "--charcoal",
      "--charcoal-700",
      "--charcoal-800",
      "--cream",
      "--cream-100",
      "--cream-200",
      "--cream-50",
      "--dur-ambient",
      "--dur-base",
      "--dur-fast",
      "--dur-slow",
      "--ease-in-out",
      "--ease-out",
      "--error",
      "--fg-inverse",
      "--fg1",
      "--fg2",
      "--fg3",
      "--fg4",
      "--fg5",
      "--font-mono",
      "--font-sans",
      "--font-script",
      "--font-serif",
      "--foreground",
      "--gold",
      "--gold-soft",
      "--hairline",
      "--hairline-strong",
      "--radius-0",
      "--radius-lg",
      "--radius-md",
      "--radius-pill",
      "--radius-sm",
      "--radius-xl",
      "--s-1",
      "--s-10",
      "--s-12",
      "--s-16",
      "--s-2",
      "--s-20",
      "--s-24",
      "--s-3",
      "--s-4",
      "--s-5",
